# port0 SDK environment.
#
# Every value that becomes registry policy, or that identifies an account, is
# REQUIRED by `npm run registry:deploy`: none of them has a default, because a
# wrong value is permanent for the registry that gets created. The deploy prints
# all of them and refuses to spend anything until the deployer types `deploy`
# (or passes --yes for an unattended run).
#
# Two profiles are given below: testnet, and the partner mainnet (cedar). Copy
# the block you need. The scripts read explicit variables only; no network is
# selected in code.

# ── testnet ──────────────────────────────────────────────────────────────────

# Chain fee faucet, the 0.17 testnet protocol configuration value.
PORT0_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436
MIDEN_RPC_URL=https://rpc.testnet.miden.io
PORT0_PROVER=testnet
PORT0_NOTE_TRANSPORT=testnet

# ── partner mainnet (cedar), closed alpha ────────────────────────────────────
#
# The fee faucet and the endpoints are the network's, not the registry's.
# PORT0_FEE_FAUCET_ID=0xe69e6ca6e39df1b10c1e5399399feb
# MIDEN_RPC_URL=https://rpc.cedar.miden.io
# PORT0_PROVER=https://tx-prover.cedar.miden.io
# PORT0_NOTE_TRANSPORT=https://transport.cedar.miden.io
#
# A keyed account on this network needs an allowlist entry before its first
# transaction, which a registry and its pools do not: both are network accounts
# and are exempt. Only the operator below is affected.

# ── registry policy, permanent once deployed ────────────────────────────────

# Accepted pool code commitment, printed by `npm run pool:commitment`. The
# registry accepts this and nothing else.
PORT0_POOL_COMMITMENT=0xb3193d87f91e7a694d84de14c2bea7da627d7068d17a53b38a984a1739e0f0cb

# Register note price, in the fee asset's smallest unit. It is adjustable later
# by the admin, and it is the only defense against a flood of pools.
PORT0_REGISTER_FEE=119

# Account that receives every pool's protocol fees. Only ever the recipient of a
# payout note, so it needs no keys and may be any account, including a wallet.
PORT0_PROTOCOL_FEE_TO=

# The protocol's share of the LP fee, in bps of it: 1200 means the protocol takes
# 12% of whatever LP fee a pool charges, carved out of that fee rather than added
# to the swapper's cost.
PORT0_PROTOCOL_FEE_SHARE_BPS=1200

# LP fee tiers, in bps, that the registry lists as allowed. Comma-separated.
PORT0_LP_FEE_TIERS=5,30,100

# Account allowed to change the register fee, hex or bech32. Required, and never
# defaulted to the operator: the operator is throwaway, while the admin cannot be
# rotated, so losing it freezes the fee for the life of the registry. Point it at
# an account you keep, such as your wallet; only its id is stored, so the key
# never has to be in this store.
PORT0_REGISTRY_ADMIN=

# ── deployment ──────────────────────────────────────────────────────────────

# The keyed account that funds the registry, hex or bech32. Required: the script
# signs a transaction as it, so its keys must be in the store below. On a gated
# network this is the only account that needs an allowlist entry. Treat it as
# throwaway and give each deployment its own store, so retiring it is a directory
# move rather than a loss.
PORT0_OPERATOR=

# Node client store name. Keys live under ~/.miden/stores/<name>/.
PORT0_STORE=port0-registry

# Fee asset base units sent to the registry on deploy, capped: the tool sends
# whatever the operator holds above the transaction fee, up to this.
PORT0_FUND=1000
PORT0_WAIT_SECS=600

# Registry to sweep, to read the fee destination from, and for the admin panel.
PORT0_REGISTRY_ID=
