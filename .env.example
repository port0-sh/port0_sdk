# Environment file to load instead of `.env`, for one checkout serving several
# chains: PORT0_ENV_FILE=.env.mainnet.
# PORT0_ENV_FILE=

# Node RPC endpoint.
MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Prover: testnet | devnet | local | URL.
PORT0_PROVER=testnet

# Note transport: testnet | devnet | local | URL.
PORT0_NOTE_TRANSPORT=testnet

# Chain fee faucet. Verified against the chain before a deploy.
PORT0_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436

# Pool code commitment for this build. Verified before a deploy.
# Print it with `npm run pool:commitment`.
PORT0_POOL_COMMITMENT=0xb3193d87f91e7a694d84de14c2bea7da627d7068d17a53b38a984a1739e0f0cb

# Keyed account that funds a deploy; its keys must be in PORT0_STORE.
PORT0_OPERATOR=

# Client store name; keys live in ~/.miden/stores/<name>/. Use one store per chain:
# the scripts stamp the chain they first ran against and refuse a store from another.
PORT0_STORE=port0-registry

# Account allowed to change the register fee, hex or bech32. Set it to an account
# you keep: it cannot be rotated.
PORT0_REGISTRY_ADMIN=

# Registry to read from, sweep, and administer.
PORT0_REGISTRY_ID=

# The four values below seed a registry at creation and are read from chain
# afterwards: PORT0_REGISTER_FEE changes with `npm run registry:set-fee`.
# Protocol fee recipient, hex or bech32.
PORT0_PROTOCOL_FEE_TO=
# Protocol share of the LP fee, in bps of it. 1200 = 12%.
PORT0_PROTOCOL_FEE_SHARE_BPS=1200
# Allowed LP fee tiers, in bps, comma separated.
PORT0_LP_FEE_TIERS=5,30,100
# Register note price, in the fee asset's base units.
PORT0_REGISTER_FEE=119

# Base units sent to a new registry, capped by the operator's balance.
PORT0_FUND=1000

# Seconds to wait for a funding note; 0 disables the wait.
PORT0_WAIT_SECS=600

# Seconds a collect waits for the network to consume its note.
PORT0_PAYOUT_WAIT_SECS=90

# 1 deploys a registry even when a stored one matches.
PORT0_NEW_REGISTRY=
