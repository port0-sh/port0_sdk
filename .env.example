# Chain fee faucet, the 0.17 testnet protocol configuration value.
MIDEN_XYK_FEE_FAUCET_ID=0x4cbdcaffe75f0a317482224dae6436

# Accepted pool code commitment, printed by `npm run pool:commitment`.
MIDEN_XYK_POOL_COMMITMENT=0x9c702bd2ec00883a8f24228e022e9045523e809ae32e9226187463be8f59f202

# Miden node RPC endpoint.
MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Register note fee, in the fee asset's smallest unit.
MIDEN_XYK_REGISTER_FEE=133

# Fee asset base units sent to the registry on deploy, capped: the tool
# sends whatever the operator holds above the transaction fee, up to this.
MIDEN_XYK_FUND=1000

# Node client store name. Keys live under ~/.miden/stores/<name>/.
MIDEN_XYK_STORE=miden-xyk-registry

# Optional: reuse an existing funded operator account id. The deploy script
# signs a transaction as this account, so its keys must be in the store named
# above; a wallet extension's account cannot be used here. Leave this unset and
# the script creates a local operator and prints the address to fund.
MIDEN_XYK_OPERATOR=

# Prover: 'testnet', 'local', or a URL.
MIDEN_XYK_PROVER=testnet
MIDEN_XYK_WAIT_SECS=600

# Account that receives every pool's protocol fees. Required by
# `npm run registry:deploy`. This one is only ever the recipient of a payout
# note, so it needs no keys and may be any account, including your wallet.
MIDEN_XYK_PROTOCOL_FEE_TO=

# The protocol's share of the LP fee, in bps of it: 1200 means the protocol
# takes 12% of whatever LP fee a pool charges, carved out of that fee rather
# than added to the swapper's cost.
MIDEN_XYK_PROTOCOL_FEE_SHARE_BPS=1200

# LP fee tiers, in bps, that the registry lists as allowed. Comma-separated.
MIDEN_XYK_LP_FEE_TIERS=5,30,100
