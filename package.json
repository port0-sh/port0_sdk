{
  "name": "@port0.sh/sdk",
  "version": "0.3.4",
  "description": "TypeScript SDK for the port0.sh constant-product AMM. Builds XYK network notes, fee sponsorships, quotes, pool reads, and pool operations on top of @miden-sdk/miden-sdk.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/port0-sh/port0_sdk.git"
  },
  "homepage": "https://github.com/port0-sh/port0_sdk#readme",
  "bugs": {
    "url": "https://github.com/port0-sh/port0_sdk/issues"
  },
  "author": "mico <mic0@mic0.dev>",
  "keywords": [
    "miden",
    "amm",
    "dex",
    "xyk",
    "constant-product",
    "uniswap-v2",
    "typescript"
  ],
  "scripts": {
    "generate": "node scripts/export-contracts.mjs",
    "generate:export-only": "node scripts/export-contracts.mjs --no-build",
    "build": "tsup",
    "test": "vitest run",
    "test:wasm": "npm run build && node test/wasm-smoke.mjs",
    "pool:commitment": "npm run build && node scripts/pool-code-commitment.mjs",
    "registry:deploy": "npm run build && node scripts/deploy-registry.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run generate && npm run typecheck && npm test && npm run build",
    "fees:collect": "npm run build && node scripts/collect-fees.mjs",
    "registry:set-fee": "npm run build && node scripts/set-register-fee.mjs"
  },
  "peerDependencies": {
    "@miden-sdk/miden-sdk": "^0.17.6"
  },
  "devDependencies": {
    "@miden-sdk/miden-sdk": "0.17.6",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}
