{
  "name": "miden-xyk-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the MidenXYK constant-product AMM. Builds XYK network notes, fee sponsorships, quotes, pool reads, and pool operations on top of @miden-sdk/miden-sdk.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "rad://z36yP8bg7ivZT6ZnnUyAvRTZvisL9"
  },
  "author": "mico <mic0@mic0.dev>",
  "keywords": [
    "miden",
    "amm",
    "dex",
    "xyk",
    "constant-product",
    "uniswap-v2",
    "typescript"
  ],
  "scripts": {
    "generate": "node scripts/export-contracts.mjs",
    "generate:build": "node scripts/export-contracts.mjs --build",
    "build": "tsup",
    "test": "vitest run",
    "test:wasm": "npm run build && node test/wasm-smoke.mjs",
    "pool:commitment": "npm run build && node scripts/pool-code-commitment.mjs",
    "registry:deploy": "npm run build && node scripts/deploy-registry.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@miden-sdk/miden-sdk": "^0.17.0"
  },
  "devDependencies": {
    "@miden-sdk/miden-sdk": "0.17.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
